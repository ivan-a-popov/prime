[Unit]
Description=prime Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ipopov
WorkingDirectory=/home/ipopov/scripts/prime
ExecStart=/home/ipopov/scripts/prime/.venv/bin/python /home/ipopov/prime/prime_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
